{
  "name": "clatter",
  "version": "0.1.0",
  "private": true,
  "description": "CLATTER: generative drum synthesis and rhythmic destruction. A browser drum workstation from the Slop Factory, with the LXR-02's open-source synthesis engine running in WebAssembly.",
  "homepage": "https://clatter.allmyfriendsaresynths.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/clickysteve/clatter.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lxr": "node scripts/build-lxr.mjs",
    "check:lxr": "node scripts/build-lxr.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@slopfactory/core": "github:clickysteve/slopfactory-core#f567d817e12f09b5a2b62985524e40378a670fb5"
  }
}
